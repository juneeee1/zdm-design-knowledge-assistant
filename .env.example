# Server-side only. Never commit the real .env file.
HOST=127.0.0.1
PORT=4317
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
AI_ENABLED=true
AI_DAILY_REQUEST_LIMIT=100
AI_CONCURRENCY=2
