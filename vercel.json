{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run validate && npm test && npm run build:app",
  "outputDirectory": "dist",
  "functions": {
    "api/handler.mjs": {
      "maxDuration": 60,
      "includeFiles": "{knowledge/**,governance/*.json,packages/zdm-card-knowledge/references/catalog.json,source/card-finder/assets/cards/*.png,dist/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/handler" }]
}
